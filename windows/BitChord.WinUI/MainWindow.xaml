<Window
    x:Class="BitChord.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="BitChord">
    <Grid Background="{ThemeResource PageBackgroundBrush}">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#17152B" Offset="0"/>
                <GradientStop Color="#0D0F16" Offset="0.52"/>
                <GradientStop Color="#101C2B" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <NavigationView x:Name="RootNavigation"
                        Grid.Row="0"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Left"
                        SelectionChanged="NavigationView_SelectionChanged"
                        Background="Transparent"
                        PaneBackground="#321B1B28"
                        AlwaysShowHeader="False">
            <NavigationView.PaneHeader>
                <StackPanel Margin="20,20,20,28">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="13" Background="{ThemeResource AccentStrongBrush}">
                            <TextBlock Text="B" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="BitChord" FontSize="19" FontWeight="SemiBold"/>
                            <TextBlock Text="Music, in full color" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" Tag="home" Icon="Home"/>
                <NavigationViewItem Content="Explore" Tag="explore" Icon="Globe"/>
                <NavigationViewItem Content="Library" Tag="library" Icon="Library"/>
                <NavigationViewItem Content="Downloads" Tag="downloads" Icon="Download"/>
                <NavigationViewItem Content="Queue" Tag="queue" Icon="List"/>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Settings" Tag="settings" Icon="Setting"/>
            </NavigationView.FooterMenuItems>
            <Frame x:Name="ContentFrame"/>
        </NavigationView>

        <Border Grid.Row="1" Margin="24,0,24,20" Padding="16,12" Style="{StaticResource GlassCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="48" Height="48" CornerRadius="12" Background="#3D8D6BFF">
                    <TextBlock Text="♫" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,20,0" VerticalAlignment="Center">
                    <TextBlock Text="Midnight City" FontWeight="SemiBold"/>
                    <TextBlock Text="M83  •  Hurry Up, We're Dreaming" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PreviousButton" Click="PreviousButton_Click" Content="‹" FontSize="24" Style="{StaticResource DefaultButtonStyle}"/>
                    <Button x:Name="PlayButton" Click="PlayButton_Click" Content="▶" FontSize="17" Margin="4,0" Style="{StaticResource AccentButtonStyle}"/>
                    <Button x:Name="NextButton" Click="NextButton_Click" Content="›" FontSize="24" Style="{StaticResource DefaultButtonStyle}"/>
                    <Slider Width="130" Value="42" Margin="18,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
