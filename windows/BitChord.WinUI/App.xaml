<Application
    x:Class="BitChord.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BitChord.WinUI">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="TabViewButtonBackground" Color="#42FFFFFF"/>
                    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#0D0F16"/>
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#42FFFFFF"/>
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#28FFFFFF"/>
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8F8FC"/>
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A9AABC"/>
                    <SolidColorBrush x:Key="AccentBrush" Color="#B59CFF"/>
                    <SolidColorBrush x:Key="AccentStrongBrush" Color="#8D6BFF"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TabViewButtonBackground" Color="#BFFFFFFF"/>
                    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F1F0F7"/>
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#BFFFFFFF"/>
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#5AFFFFFF"/>
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#17151E"/>
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#676273"/>
                    <SolidColorBrush x:Key="AccentBrush" Color="#6750C7"/>
                    <SolidColorBrush x:Key="AccentStrongBrush" Color="#4F38B5"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <!-- Fallback available before theme dictionaries are selected. -->
            <SolidColorBrush x:Key="TabViewButtonBackground" Color="Transparent"/>
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable"/>
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
            </Style>
            <Style x:Key="GlassCard" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="22"/>
                <Setter Property="Padding" Value="20"/>
            </Style>
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,0,14"/>
            </Style>
            <Style x:Key="DefaultButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="10,6"/>
            </Style>
            <Style x:Key="AccentButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource AccentStrongBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="CornerRadius" Value="18"/>
                <Setter Property="Padding" Value="14,8"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
